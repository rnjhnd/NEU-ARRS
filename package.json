{
  "name": "temp-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:check": "node scripts/check-build.mjs",
    "start": "next start",
    "lint": "eslint",
    "audit:security": "npm audit --audit-level=low",
    "test:migrations": "node scripts/test-migrations.mjs",
    "test:navigation": "playwright test --config playwright.navigation.config.ts",
    "db:status": "prisma migrate status --config prisma.migration.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma.migration.config.ts",
    "db:backfill-identities": "node scripts/backfill-request-identities.mjs",
    "db:reconcile-money": "node scripts/reconcile-money.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@clerk/nextjs": "^7.4.3",
    "@clerk/themes": "^2.4.57",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "2.3.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.40.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.17.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "react": "19.2.9",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.9",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@electric-sql/pglite-socket": "0.1.3",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.19.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@react-email/components": {
      "@react-email/render": "$@react-email/render"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.7"
    }
  }
}
