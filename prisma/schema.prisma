// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleChangeStage {
  PREPARED
  APPLYING
  REVOKING
  COMPLETE
  REJECTED
}

model RoleAccess {
  userId      String   @id
  role        String
  operationId String
  blocked     Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model RoleChangeOperation {
  id           String          @id
  actorId      String
  targetId     String
  previousRole String
  previousOperationId String
  nextRole     String
  stage        RoleChangeStage @default(PREPARED)
  activeKey    String?         @unique
  leaseToken   String?
  leaseUntil   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}


enum RequestStatus {
  PENDING_PAYMENT
  PROCESSING
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  CASH_ON_PICKUP
  REFUNDED
}

enum Purpose {
  EMPLOYMENT
  BOARD_EXAM
  TRANSFER
  SCHOLARSHIP
  PERSONAL
  OTHER
}

model Request {
  id                  String         @id @default(cuid())
  studentId           String         // Clerk userId
  studentName         String
  studentNumber       String
  documentType        String
  purpose             Purpose
  paymentMethod       String         // "online" | "cash"
  paymentStatus       PaymentStatus  @default(UNPAID)
  paymongoCheckoutId  String?        // PayMongo checkout session ID
  paymongoPaymentId   String?        // PayMongo payment ID (from webhook)
  paymongoPaymentType String?        // e.g., "gcash", "maya", "card", "qrph"
  // Read-only legacy evidence: historical units differ. Never infer or write
  // money here; verified collections live in RequestMoney (integer centavos).
  amountPaid          Int?
  money               RequestMoney?
  status              RequestStatus  @default(PENDING_PAYMENT)
  cancelReason        String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  submissionKey       String?        // Client intent UUID, scoped to the authenticated student
  quotedAmountCentavos Int?          // Immutable server quote; null for historical orders
  checkoutAttempt     CheckoutAttempt?
  notificationVersion Int            @default(0)
  notifications       NotificationOutbox[]
  identityReview      RequestIdentityReview?
  completion          RequestCompletion?

  @@unique([studentId, submissionKey])
  @@index([studentId])
  @@index([updatedAt(sort: Desc), id], map: "Request_staff_queue_idx")
  @@index([status, updatedAt(sort: Desc), id], map: "Request_staff_status_queue_idx")
  @@index([createdAt, id], map: "Request_finance_period_idx")
  @@index([studentId, updatedAt(sort: Desc), id], map: "Request_student_history_idx")
  @@index([studentId, status], map: "Request_student_summary_idx")
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentMethod, status, paymentStatus, createdAt, id], map: "Request_cleanup_scan_idx")
}

// A registrar attestation applies only to this exact request/account identity.
// Removing an active attestation never removes its immutable AuditLog evidence.
model RequestIdentityReview {
  requestId     String   @id
  request       Request  @relation(fields: [requestId], references: [id], onDelete: Restrict)
  studentId     String
  studentName   String
  studentNumber String
  verifiedBy    String
  verifiedAt    DateTime @default(now())
  evidenceId    String   @unique
  evidence      AuditLog @relation("IdentityEvidence", fields: [evidenceId], references: [id], onDelete: Restrict)
}

enum MoneySource {
  PAYMONGO_PAYMENT
  CASH_CONFIRMATION
  HISTORICAL_VERIFIED
}

model RequestMoney {
  requestId          String      @id
  request            Request     @relation(fields: [requestId], references: [id], onDelete: Restrict)
  currency           String      @default("PHP")
  method             String
  collectedCentavos  Int
  source             MoneySource
  reference          String      @unique
  evidenceId         String      @unique
  collectionEvidence AuditLog    @relation("CollectionEvidence", fields: [evidenceId], references: [id], onDelete: Restrict)
  verifiedAt         DateTime    @default(now())
  paidAt             DateTime?
  // Null means no verified refund total has been recorded, not a zero refund.
  refundedCentavos   Int?
  refundEvidenceId   String?     @unique
  refundEvidence     AuditLog?   @relation("RefundEvidence", fields: [refundEvidenceId], references: [id], onDelete: Restrict)
  refundVerifiedAt   DateTime?
  dates              MoneyMovementDate[]

  @@index([paidAt, requestId], map: "RequestMoney_paid_date_idx")
}

enum MoneyMovementKind {
  COLLECTION
  REFUND
}

model MoneyMovementDate {
  requestId  String
  money      RequestMoney @relation(fields: [requestId], references: [requestId], onDelete: Restrict)
  kind       MoneyMovementKind
  occurredAt DateTime
  recordedAt DateTime @default(now())
  evidenceId String @unique
  evidence   AuditLog @relation("MovementDateEvidence", fields: [evidenceId], references: [id], onDelete: Restrict)

  @@id([requestId, kind])
  @@index([kind, occurredAt, requestId], map: "MoneyMovementDate_period_idx")
}

model RequestCompletion {
  requestId   String @id
  request     Request @relation(fields: [requestId], references: [id], onDelete: Restrict)
  completedAt DateTime
  evidenceId  String @unique
  evidence    AuditLog @relation("CompletionEvidence", fields: [evidenceId], references: [id], onDelete: Restrict)
}

enum NotificationState {
  QUEUED
  IN_FLIGHT
  SENT
  REVIEW
  SUPERSEDED
}

model NotificationOutbox {
  id                    String            @id
  requestId             String
  request               Request           @relation(fields: [requestId], references: [id], onDelete: Restrict)
  version               Int
  studentId             String
  status                RequestStatus
  correction            Boolean           @default(false)
  content               Json
  state                 NotificationState @default(QUEUED)
  payload               Json?
  firstAttemptAt        DateTime?
  credentialFingerprint String?
  attempts              Int               @default(0)
  retryLimit            Int               @default(5)
  nextAttemptAt         DateTime          @default(now())
  leaseToken            String?
  providerEmailId       String?
  lastError             String?
  sentAt                DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([requestId, version])
  @@index([state, nextAttemptAt, createdAt, id], map: "NotificationOutbox_due_idx")
}

model CronJobState {
  name            String   @id
  leaseToken      String?
  leaseUntil      DateTime
  cursorCreatedAt DateTime?
  cursorId        String?
  updatedAt       DateTime @updatedAt
}

model CheckoutAttempt {
  requestId      String   @id
  request        Request  @relation(fields: [requestId], references: [id], onDelete: Restrict)
  idempotencyKey String   @unique @default(uuid())
  payload        Json     // Frozen provider parameters; never contains API credentials
  livemode       Boolean
  credentialFingerprint String // SHA-256 of the high-entropy key, never the key itself
  createdAt      DateTime @default(now())
  leaseUntil     DateTime
}

model DocumentConfig {
  id          String   @id @default(cuid())
  typeId      String   @unique // e.g., "TOR", "DIPLOMA", "GOOD_MORAL"
  label       String   // e.g., "Transcript of Records"
  description String   // e.g., "Official academic history"
  price       Int      @default(0) // Price in centavos (e.g., 15000 = ₱150.00)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemSettings {
  id        String   @id @default(cuid())
  key       String   @unique // e.g., "EMAIL_TEMPLATES"
  value     String   // JSON stringified configuration
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String   // Legacy field name: Clerk actor ID or system service ID
  action    String   // e.g., 'STATUS_OVERRIDE', 'ROLE_GRANTED'
  details   String   // Contextual information
  requestId String?  // Optional relation if it pertains to a request
  createdAt DateTime @default(now())
  collectionMoney RequestMoney? @relation("CollectionEvidence")
  refundMoney RequestMoney? @relation("RefundEvidence")
  identityReview RequestIdentityReview? @relation("IdentityEvidence")
  movementDate MoneyMovementDate? @relation("MovementDateEvidence")
  completion RequestCompletion? @relation("CompletionEvidence")

  @@index([adminId])
  @@index([requestId])
}
